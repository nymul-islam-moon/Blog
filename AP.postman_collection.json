  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Auth \u2014 Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Author\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret1234\",\n  \"password_confirmation\": \"secret1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registered (201)\", function(){ pm.response.to.have.status(201); });",
                  "try { var d = pm.response.json(); if (d.user && d.user.id) pm.environment.set(\"new_user_id\", d.user.id); } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth \u2014 Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"12345678\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login OK (200)\", function(){ pm.response.to.have.status(200); });",
                  "var d = pm.response.json(); pm.environment.set(\"token\", d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth \u2014 Me",
          "request": {
